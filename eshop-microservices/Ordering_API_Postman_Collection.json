        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:5003/orders/by-name/O0001",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5003",
          "path": ["orders", "by-name", "O0001"]
        },
        "description": "Search and filter orders by their name. Name is case-insensitive and supports partial matches."
      }
    },
    {
      "name": "3. GET - Orders by Customer",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
