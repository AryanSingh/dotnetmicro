      "name": "1. GET - List All Orders (Paginated)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:5003/orders?PageIndex=0&PageSize=10",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5003",
          "path": ["orders"],
          "query": [
            {
              "key": "PageIndex",
              "value": "0"
            },
            {
              "key": "PageSize",
              "value": "10"
            }
          ]
        },
        "description": "Retrieve all orders with pagination support. Returns paginated result with page metadata."
      }
    },
    {
